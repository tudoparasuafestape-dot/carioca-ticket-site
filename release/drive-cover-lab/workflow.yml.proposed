name: Isolated Drive cover HTML lab (manual)
on:
  workflow_dispatch:
    inputs:
      mode:
        type: choice
        options: [publish, rollback]
        required: true
      expected_guard_sha:
        type: string
        required: true
      expected_current_deployment:
        type: string
        required: true
      confirmation:
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: ct-pages-production
  cancel-in-progress: false
jobs:
  publication:
    if: github.repository == 'tudoparasuafestape-dot/carioca-ticket-site' && github.ref == 'refs/heads/main' && github.run_attempt == 1
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      actions: read
      deployments: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    env:
      CT_MODE: ${{ inputs.mode }}
      CT_EXPECTED_GUARD_SHA: ${{ inputs.expected_guard_sha }}
      CT_EXPECTED_DEPLOYMENT: ${{ inputs.expected_current_deployment }}
      CT_CONFIRMATION: ${{ inputs.confirmation }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - name: Offline safety tests
        run: python -m unittest discover -s release/drive-cover-lab -p 'test_*.py' -v
      - name: Validate baseline and prepare exact archive
        env:
          GH_TOKEN: ${{ github.token }}
        run: python release/drive-cover-lab/release_guard.py prepare release/drive-cover-lab "$RUNNER_TEMP/drive-cover-stage"
      - name: Read-only public baseline preflight
        run: python release/drive-cover-lab/release_guard.py preflight release/drive-cover-lab "$RUNNER_TEMP/drive-cover-stage"
      - name: Preserve rollback before publishing
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: drive-cover-lab-rollback-and-seal
          path: |
            ${{ runner.temp }}/drive-cover-stage/rollback.tar
            ${{ runner.temp }}/drive-cover-stage/seal.json
          if-no-files-found: error
          retention-days: 30
          overwrite: false
          compression-level: 0
      - name: Recheck immediately before Pages artifact upload
        env:
          GH_TOKEN: ${{ github.token }}
        run: python release/drive-cover-lab/release_guard.py recheck release/drive-cover-lab "$RUNNER_TEMP/drive-cover-stage"
      - name: Upload only reviewed Pages TAR
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: github-pages
          path: ${{ runner.temp }}/drive-cover-stage/artifact.tar
          if-no-files-found: error
          retention-days: 30
          overwrite: false
          compression-level: 0
      - name: Final live baseline gate
        env:
          GH_TOKEN: ${{ github.token }}
        run: python release/drive-cover-lab/release_guard.py recheck release/drive-cover-lab "$RUNNER_TEMP/drive-cover-stage"
      - name: Publish exact artifact (requires specific prior owner approval)
        id: deploy
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346
        with:
          artifact_name: github-pages
      - name: Read-only post-publication verification
        env:
          GH_TOKEN: ${{ github.token }}
        run: python release/drive-cover-lab/release_guard.py postverify release/drive-cover-lab "$RUNNER_TEMP/drive-cover-stage"
# No automatic rollback. Any failed/uncertain run must be inspected, never rerun blindly.
